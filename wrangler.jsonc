{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "real-or-slop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "build": {
    "command": "npm run build",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  // Daily maintenance at 03:17 UTC: games older than 12 months are deleted (docs/privacy-note-legali.v1.0.0.md).
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "real-or-slop-local",
      "migrations_dir": "migrations",
      "database_id": "98a3e712-d9f9-4510-91ab-2b80329be753",
    },
  ],
  "r2_buckets": [
    {
      "binding": "QUARANTINE",
      "bucket_name": "real-or-slop-quarantine",
    },
    {
      "binding": "IMAGES",
      "bucket_name": "real-or-slop-approved",
    },
  ],
  // Cloudflare Workers Builds, «Previews Base» tab (template of each new preview; an existing branch keeps its own build trigger), Preview command: npx wrangler d1 migrations apply DB --remote --env preview && npm run preview.
  // Previews of the pull requests (npm run preview = scripts/check-preview.mjs, then wrangler preview --ignore-base-config) use only
  // these bindings: their own D1 database and R2 buckets, never the production ones above (2026-11-12, owner request).
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "real-or-slop-preview",
        "migrations_dir": "migrations",
        "database_id": "50944190-1b11-4504-af54-bbbc62b971a6",
      },
    ],
    "r2_buckets": [
      {
        "binding": "QUARANTINE",
        "bucket_name": "real-or-slop-preview-quarantine",
      },
      {
        "binding": "IMAGES",
        "bucket_name": "real-or-slop-preview-approved",
      },
    ],
  },
  // PvP removed on 2026-11-12 (docs/gioco-a-livelli.v1.0.0.md): the GameRoom Durable Object class is deleted with its storage.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["GameRoom"],
    },
  ],
  "env": {
    "local": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "real-or-slop-local",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "real-or-slop-approved-local",
        },
        {
          "binding": "QUARANTINE",
          "bucket_name": "real-or-slop-quarantine-local",
        },
      ]
    },
    // Only to apply the migrations to the preview database before each preview build:
    // npx wrangler d1 migrations apply DB --remote --env preview. Never deployed.
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "real-or-slop-preview",
          "migrations_dir": "migrations",
          "database_id": "50944190-1b11-4504-af54-bbbc62b971a6",
        },
      ],
      "r2_buckets": [
        {
          "binding": "QUARANTINE",
          "bucket_name": "real-or-slop-preview-quarantine",
        },
        {
          "binding": "IMAGES",
          "bucket_name": "real-or-slop-preview-approved",
        },
      ],
    },
  },
  "account_id": "89bb1f60467dcfd2147871748f0f9645",
}
