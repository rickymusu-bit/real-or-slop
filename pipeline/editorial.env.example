# Template only. No keys or paid activation. Source it in a PRIVATE executor,
# then set real secrets through that executor's secret manager.
ENABLE_EDITORIAL_PAID=false
# Actions-only flag for the dormant daily workflow; never enabled here.
# ENABLE_EDITORIAL_SCHEDULE=false
OPENAI_ANALYSIS_MODEL=gpt-6.1-terra
OPENAI_EVALUATOR_MODEL=gpt-6.1-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
EDITORIAL_THRESHOLD=65
EDITORIAL_ATTEMPTS=2
EDITORIAL_MAX_EVALUATIONS=60
EDITORIAL_MAX_GENERATIONS=20
EDITORIAL_MAX_REGENERATIONS=10
EDITORIAL_QUEUE_LIMIT=100
# Explicit, conservative upper bounds in USD for selected models/parameters.
# Zero deliberately prevents paid execution until an operator verifies prices.
EDITORIAL_RUN_USD=0
EDITORIAL_DAILY_USD=0
EDITORIAL_EVALUATION_USD=0
EDITORIAL_GENERATION_USD=0
# No default rights grant. Set only after checking the generator's terms,
# the source's obligations and the intended publication rights.
GENERATED_LICENSE_NAME=
GENERATED_LICENSE_URL=
# Secrets (never put their values in this file):
# OPENAI_API_KEY
# REAL_OR_SLOP_ADMIN_TOKEN
