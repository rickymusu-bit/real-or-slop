# Optional source credentials. Never put them in frontend files or artifacts.
# Source collection remains explicit through --live; no schedule is enabled.
# Openverse: use an existing bearer token OR an already registered OAuth client.
OPENVERSE_ACCESS_TOKEN=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Smithsonian's existing official connector.
SMITHSONIAN_API_KEY=
# Brave Image Search is optional and excluded from the default engine list.
# A key alone does not enable calls: also pass --allow-paid-search and positive
# --search-budget-usd / --brave-request-usd with a bounded --max-api-calls.
BRAVE_IMAGE_SEARCH_KEY=
