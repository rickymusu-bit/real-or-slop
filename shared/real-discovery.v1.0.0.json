{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:real-or-slop:real-discovery:1.0.0",
  "version": "1.0.0",
  "created_at": "2026-11-06T14:00:00Z",
  "$defs": {
    "intent": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "1.0.0"
          ]
        },
        "taxonomy_version": {
          "type": "string",
          "enum": [
            "1.0.0"
          ]
        },
        "topic": {
          "type": "string",
          "enum": [
            "people_everyday_life",
            "animals",
            "food_cooking",
            "travel_landscapes",
            "homes_architecture",
            "fashion_beauty_lifestyle",
            "products_consumption",
            "arts_crafts",
            "sports_entertainment",
            "news_current_affairs",
            "science_technology",
            "history_archives"
          ]
        },
        "emotion": {
          "type": "string",
          "enum": [
            "wonder",
            "tenderness",
            "compassion",
            "outrage",
            "fear",
            "disgust",
            "desire",
            "nostalgia",
            "amusement",
            "curiosity",
            "admiration",
            "neutrality"
          ]
        },
        "intensity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "version",
        "taxonomy_version",
        "topic",
        "emotion",
        "intensity"
      ],
      "additionalProperties": false
    },
    "strategies": {
      "type": "object",
      "properties": {
        "strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50,
                "pattern": "[a-z][a-z0-9_-]{0,49}"
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": [
              "id",
              "query",
              "rationale"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "strategies"
      ],
      "additionalProperties": false
    },
    "adaptation": {
      "type": "object",
      "properties": {
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "text",
                  "category"
                ]
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 10,
                "maxLength": 180,
                "pattern": "Category:[^|{}\\[\\]<>\\n\\r]+"
              },
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12,
                "pattern": "[a-z]{2,3}(-[A-Z]{2})?"
              }
            },
            "required": [
              "mode",
              "query",
              "category",
              "language"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "variants"
      ],
      "additionalProperties": false
    },
    "visual": {
      "type": "object",
      "properties": {
        "photographic": {
          "type": "boolean"
        },
        "usable": {
          "type": "boolean"
        },
        "emotions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "wonder",
              "tenderness",
              "compassion",
              "outrage",
              "fear",
              "disgust",
              "desire",
              "nostalgia",
              "amusement",
              "curiosity",
              "admiration",
              "neutrality"
            ]
          },
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "people_everyday_life",
              "animals",
              "food_cooking",
              "travel_landscapes",
              "homes_architecture",
              "fashion_beauty_lifestyle",
              "products_consumption",
              "arts_crafts",
              "sports_entertainment",
              "news_current_affairs",
              "science_technology",
              "history_archives"
            ]
          },
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true
        },
        "intensity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "neutral",
            "unknown"
          ]
        },
        "valence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "attention": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "readability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "plausibility": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "game_potential": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "required": [
        "photographic",
        "usable",
        "emotions",
        "topics",
        "intensity",
        "valence",
        "attention",
        "readability",
        "plausibility",
        "game_potential",
        "observations",
        "uncertainties"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "string",
          "enum": [
            "zero_hits",
            "provider_error",
            "rate_limited",
            "partial",
            "license_unresolved",
            "origin_unverified",
            "duplicate",
            "human_approved",
            "human_rejected",
            "pending"
          ]
        }
      },
      "required": [
        "id",
        "intent",
        "candidate_id",
        "revision",
        "outcome"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "1.0.0"
          ]
        },
        "provider": {
          "type": "string",
          "enum": [
            "commons",
            "openverse"
          ]
        },
        "query": {
          "$ref": "#/$defs/adaptation"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "zero_hits",
            "partial",
            "rate_limited",
            "error",
            "uncertain"
          ]
        },
        "returned": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "api_calls": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "version",
        "provider",
        "query",
        "status",
        "returned",
        "api_calls",
        "elapsed_seconds",
        "http_status",
        "reason",
        "cost_usd"
      ],
      "additionalProperties": false
    },
    "provider_profile": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "enum": [
            "1.0.0"
          ]
        },
        "provider": {
          "type": "string",
          "enum": [
            "commons",
            "openverse"
          ]
        },
        "endpoint": {
          "type": "string",
          "enum": [
            "https://commons.wikimedia.org/w/api.php",
            "https://api.openverse.org/v1/images/"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 10
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "category"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "action",
              "format",
              "generator",
              "gsrsearch",
              "gsrnamespace",
              "gsrlimit",
              "gsroffset",
              "prop",
              "iiprop",
              "titles",
              "gcmtype",
              "gcmtitle",
              "gcmlimit",
              "gcmcontinue",
              "q",
              "page",
              "page_size",
              "license"
            ]
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "filters": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "integer",
              "enum": [
                6
              ]
            },
            "media": {
              "type": "string",
              "enum": [
                "image"
              ]
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "license"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "page_size": {
              "type": "integer",
              "enum": [
                20
              ]
            },
            "max_pages": {
              "type": "integer",
              "enum": [
                3
              ]
            },
            "timeout_seconds": {
              "type": "integer",
              "enum": [
                20
              ]
            },
            "max_response_bytes": {
              "type": "integer",
              "enum": [
                8000000
              ]
            }
          },
          "required": [
            "page_size",
            "max_pages",
            "timeout_seconds",
            "max_response_bytes"
          ],
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "properties": {
            "verified_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "source_sha256": {
              "type": "string",
              "pattern": "[a-f0-9]{64}"
            },
            "source_url": {
              "type": "string",
              "pattern": "https://[^\\s]+",
              "maxLength": 2000
            },
            "live_access": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "verified_at",
            "method",
            "source_sha256",
            "source_url",
            "live_access"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "version",
        "provider",
        "endpoint",
        "languages",
        "modes",
        "parameters",
        "filters",
        "limits",
        "verification",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/intent"
}
