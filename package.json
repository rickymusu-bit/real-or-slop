{
  "name": "real-or-slop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --ip 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build && node scripts/check-assets.mjs",
    "lint": "eslint src worker tests",
    "test": "node --import tsx --test tests/*.test.ts && python3 -m unittest discover -s tests -p '*_test.py'",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file scripts/seed.sql",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "preview": "node scripts/check-preview.mjs && wrangler preview --ignore-base-config",
    "test:integration": "python3 scripts/integration.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "jsonc-parser": "3.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
