{
  "name": "real-or-slop",
  "version": "1.35.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --env local --ip 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build && node scripts/check-assets.mjs",
    "lint": "eslint src worker shared tests scripts/check-preview.mjs",
    "test": "node --import tsx --import ./tests/cloudflare-workers.mjs --test tests/*.test.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local --env local",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "preview": "node scripts/check-preview.mjs && wrangler preview --ignore-base-config",
    "test:integration": "python3 scripts/integration.py",
    "deploy": "wrangler deploy",
    "deploy:demo": "npm run deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "jsonc-parser": "3.3.1",
    "sharp": "^0.34.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
