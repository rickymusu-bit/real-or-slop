digraph pipeline {
 graph [rankdir=TB,bgcolor="#f8fafc",pad="0.3",nodesep="0.3",ranksep="0.35",fontname="DejaVu Sans",fontsize=22,label="How a SLOP photo is made",labelloc=t,compound=true];
 node [shape=box,style="rounded,filled",fillcolor=white,color="#94a3b8",fontname="DejaVu Sans",fontsize=15,margin="0.18,0.12"];
 edge [color="#64748b",fontname="DejaVu Sans",fontsize=12];
 legend [shape=plaintext,label="Blue = model call · White = free work · Yellow = your decision\nPaid phases show their maximum. Approval includes observation.\nCalls with uncertain outcomes are never retried automatically."];
 subgraph cluster_prepare {
  label="1. PREPARE THE GALLERY"; color="#cbd5e1"; style=rounded; fontsize=18;
  real [label="Import REAL photos into a gallery\nKeep originals and source credits"];
  describe [label="Describe missing REAL photos\n1 confirmed call per photo · full original\nSaves English description + parameters",fillcolor="#dbeafe"];
  settings [label="Read prepared REAL parameters · free\nReview rules and variation chances\nNo legacy parameter rewrite controls"];
  real -> describe -> settings;
 }
 subgraph cluster_choose {
  label="2. CHOOSE REAL AND PREPARE SCENES";color="#cbd5e1";style=rounded;fontsize=18;
  choose [label="Select the REAL photos to start from\nThumbnails without Commons titles\nSort by date added or approved SLOP count\nKeep selections and unsaved fields when sorting\nOne selected REAL = one new scene\nApproval counts appear only in this wizard\nDiscarded candidates do not count\nVerified older source links are recovered\nMissing attributions are shown separately"];
  coverage [label="Compare REAL and accepted SLOP observations\nMissing observations are shown and excluded\nSLOP are observed automatically at approval\nExisting observations are reused",fillcolor="#dbeafe"];
  draw [label="Automatically choose environment and genre · free\nChange only when observed distributions improve\nUse a joint photographic context from REAL\nBalance against observations + earlier group draws"];
  scene [label="Write the new English scenes\n1 confirmed text call per selected REAL",fillcolor="#dbeafe"];
  review [label="Read and edit each scene · free\nCheck changes, dependencies and photo format"];
  coverage -> choose -> draw -> scene -> review;
 }
 subgraph cluster_images {
  label="3. GENERATE AND REVIEW IMAGES";color="#cbd5e1";style=rounded;fontsize=18;
  generate [label="Generate images from saved scene text\n1 separately confirmed call per scene\nREAL pixels are not sent to the generator",fillcolor="#dbeafe"];
  inspect [label="Inspect the full image and decide\nAccept it or discard and close · free\nOptional evaluation: 1 confirmed call\nOptional correction: preview mask + confirm 1 call\nAfter an edit, inspect again before deciding",fillcolor="#fef3c7"];
  copy [label="Accept: automatically prepare the game copy · free\nBrowser applies treatment + shared 4:5 WebP encoding\nStart with the full photo and black bars\nMissing reference: show untreated fallback"] ;
  generate -> inspect -> copy;

 }
 subgraph cluster_finish {
  label="4. FINAL REVIEW AND APPROVAL";color="#cbd5e1";style=rounded;fontsize=18;
  final_review [label="Review the ready game copy beside the full image\nAdjust treatment or framing if needed · free"];
  approve [label="Select checked SLOP game copies\nApprove one photo or the selected group\nPhotos without a ready copy cannot be selected\nApproved photos leave this wizard",fillcolor="#fef3c7"];
  observe [label="Automatically observe the full SLOP original\nAt most 1 model call, included in approval\nReuse saved observations · no separate confirmation",fillcolor="#dbeafe"];
  publish [label="Find the photo in the gallery and publish it · free\nOnly published photos enter the game",fillcolor="#dcfce7"];
  final_review -> approve -> observe -> publish;
 }
 notes [shape=plaintext,fontsize=12,label="Paid work continues on the server if the page closes.\nBrowser copies need an open page; missing copies resume on return.\nSaved copies and your adjustments are kept. Stop cancels unsent paid work.\nAcquired calls finish. Approval starts observation; other phases stay separately confirmed.\nAccepting an image does not publish it."];
 legend -> real [style=invis];settings -> coverage [style=invis];review -> generate [style=invis];copy -> final_review [style=invis];publish -> notes [style=invis];
}
