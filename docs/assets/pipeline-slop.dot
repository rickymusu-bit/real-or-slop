digraph pipeline {
 graph [rankdir=TB,bgcolor="#f7f8fc",pad="0.4",nodesep="0.35",ranksep="0.45",fontname="DejaVu Sans",label="REAL or SLOP · Complete pipeline",labelloc=t,fontsize=24];
 node [shape=box,style="rounded,filled",fillcolor=white,color="#cad2e0",fontname="DejaVu Sans",fontsize=12,margin="0.18,0.12"];
 edge [color="#63738c",fontname="DejaVu Sans",fontsize=10];
 real [label="1 · Gallery REAL\nFull originals and credits; missing descriptions flagged"];
 describe [label="2 · English description\nEight axes · observed parameters · photographic genre\nPeculiarities: identity, specimen, temporary state\nTechnical measurements and aspect ratio",fillcolor="#eaf1ff"];
 index [label="3 · Gallery indexes and composition\nSubjects · environments · distributions and combinations\nGallery-specific rules"];
 draw [label="4 · Select REAL and draw zero or more variations\nModel, color, finish, edition, wear, damage, ageing, cleanliness\nState, screen content, pose, camera, composition, aspect ratio\nEnvironment/genre: coordinate dependent changes"];
 scene [label="5 · Sol prepares a complete scene on all eight axes\nPlausible novelty and ordinary values · physical constraints\nPeculiarities preserved or varied · explicit changes",fillcolor="#eaf1ff"];
 confirm [label="Review scene and confirm maximum calls",fillcolor="#fff1d6"];
 generate [label="6 · Sunburst /images/generations\nFinal text only · dimensions match the aspect ratio",fillcolor="#eaf1ff"];
 evaluate [label="7 · Evaluator: full image and constraints\nHardware, plausibility, peculiarities and parameter drift\nFindings and suggested edits with benefits and risks",fillcolor="#eaf1ff"];
 decision [shape=diamond,label="Owner decision",fillcolor="#fff1d6"];
 edit [label="Selected and confirmed correction\n/images/edits · full image + local mask\nBefore/after comparison · no automatic loop",fillcolor="#eaf1ff"];
 discard [label="Discard or close",fillcolor="#ffe8e8"];
 accept [label="8 · Accept full image"];
 treatment [label="9 · Photographic treatment, when needed\nSharpness, noise, contrast and color\nREAL references relevant to the target genre\nAdjustable · no uniform filter across all SLOP"];
 copy [label="10 · Shared REAL and SLOP preparation\n4:5 framing · dimensions · same WebP compression\nMetadata removed · common mark"];
 publish [label="11 · Final visual check → Approve → Publish",fillcolor="#e5f5eb"];
 real -> describe [label="confirm missing calls"]; describe -> index -> draw -> scene -> confirm -> generate -> evaluate -> decision;
 decision -> edit [label="edit: separate confirmation"];edit -> decision [style=dashed,label="human review"];
 decision -> discard [label="discard"];decision -> accept [label="accept"];accept -> treatment -> copy -> publish;
 real -> copy [style=dashed,label="same technical recipe",constraint=false];
}
